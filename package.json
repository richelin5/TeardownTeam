{
  "name": "company-teardown",
  "version": "1.0.0",
  "private": true,
  "description": "One-page company profile from SEC EDGAR and FRED, with a source on every number.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "TEARDOWN_FIXTURES=1 vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "5.9",
    "vite": "^7.3.8",
    "vitest": "^5.1.2"
  }
}
