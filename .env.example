# Copy to .env for `netlify dev`. Never commit real values.
# SEC requires a declared User-Agent: "<App name> <contact email>"
SEC_USER_AGENT="CompanyTeardown your-email@example.com"
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here
# Local only: serve AAPL/MSFT/KO from fixtures/ with no network or keys. Never set on Netlify.
# TEARDOWN_FIXTURES=1
